<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="CreeperUX.Music.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                Visual language (CreeperUX, Spotify's layout): three rounded panels on a near-black window, the playback
                bar along the bottom, one amber accent for what is playing, progress and the main Play buttons.
            -->
            <Color x:Key="SystemAccentColor">#FFF8B700</Color>
            <Color x:Key="SystemAccentColorLight1">#FFFFC233</Color>
            <Color x:Key="SystemAccentColorLight2">#FFFFCF5C</Color>
            <Color x:Key="SystemAccentColorLight3">#FFFFDD8A</Color>
            <Color x:Key="SystemAccentColorDark1">#FFE5A800</Color>
            <Color x:Key="SystemAccentColorDark2">#FFC48F00</Color>
            <Color x:Key="SystemAccentColorDark3">#FF9C7100</Color>

            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#FF040607" />
            <SolidColorBrush x:Key="PanelBrush" Color="#FF121518" />
            <SolidColorBrush x:Key="RaisedBrush" Color="#FF1F2529" />
            <SolidColorBrush x:Key="RaisedHiBrush" Color="#FF2A3237" />
            <SolidColorBrush x:Key="HoverBrush" Color="#14EFEBE5" />
            <SolidColorBrush x:Key="LineBrush" Color="#1FFFFFFF" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFEFEBE5" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FFA9A59D" />
            <SolidColorBrush x:Key="TextTertiaryBrush" Color="#FF77736C" />
            <SolidColorBrush x:Key="AccentBrush" Color="#FFF8B700" />
            <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFC233" />
            <SolidColorBrush x:Key="OnAccentBrush" Color="#FF111416" />
            <SolidColorBrush x:Key="BadBrush" Color="#FFE5484D" />
            <SolidColorBrush x:Key="GoodBrush" Color="#FF3DD68C" />

            <!-- Menus: solid, as Spotify's (acrylic would also not show in RenderTargetBitmap screenshots) -->
            <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#FF242A2E" />
            <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="#1FFFFFFF" />

            <!-- Lists: selection is shown by the playing song, not by the system highlight -->
            <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#1FEFEBE5" />
            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#29EFEBE5" />
            <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#14EFEBE5" />
            <SolidColorBrush x:Key="ListViewItemSelectionIndicatorBrush" Color="#00000000" />
            <SolidColorBrush x:Key="ListViewItemSelectionIndicatorPointerOverBrush" Color="#00000000" />

            <!--
                Typography: Chinese falls back to Microsoft YaHei UI, which has no SemiBold; headings use Bold so Latin and
                Chinese match (as in Lumen).
            -->
            <FontFamily x:Key="ContentControlThemeFontFamily">Segoe UI Variable Text, Microsoft YaHei UI</FontFamily>
            <FontFamily x:Key="AppTextFont">Segoe UI Variable Text, Microsoft YaHei UI</FontFamily>
            <FontFamily x:Key="AppDisplayFont">Segoe UI Variable Display, Microsoft YaHei UI</FontFamily>
            <FontFamily x:Key="AppFigureFont">Cascadia Mono, Consolas, Microsoft YaHei UI</FontFamily>

            <Style x:Key="HeroTitleStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource AppDisplayFont}" />
                <Setter Property="FontSize" Value="48" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="LineHeight" Value="56" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="MaxLines" Value="2" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            </Style>
            <Style x:Key="PageTitleStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource AppDisplayFont}" />
                <Setter Property="FontSize" Value="30" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            </Style>
            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource AppDisplayFont}" />
                <Setter Property="FontSize" Value="22" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            </Style>
            <Style x:Key="CardTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="TextWrapping" Value="NoWrap" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            </Style>
            <Style x:Key="MutedTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            </Style>
            <Style x:Key="FigureTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource AppFigureFont}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            </Style>

            <!-- A round, borderless icon button (transport, panel toggles, "more") -->
            <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="36" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="18" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                <Setter Property="FontFamily" Value="{StaticResource SymbolThemeFontFamily}" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <Style x:Key="IconToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="36" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="18" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                <Setter Property="FontFamily" Value="{StaticResource SymbolThemeFontFamily}" />
                <Setter Property="FontSize" Value="16" />
            </Style>
            <!-- The amber Play button (page actions); the playback bar's is white -->
            <Style x:Key="PlayButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                <Setter Property="Width" Value="56" />
                <Setter Property="Height" Value="56" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="28" />
                <Setter Property="FontFamily" Value="{StaticResource SymbolThemeFontFamily}" />
                <Setter Property="FontSize" Value="22" />
                <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
            </Style>
            <Style x:Key="PillButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="Padding" Value="14,6" />
                <Setter Property="Background" Value="{StaticResource RaisedBrush}" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>
            <Style x:Key="ChipStyle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="Padding" Value="14,5" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="Background" Value="{StaticResource RaisedBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FontSize" Value="13" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
