{
  "description": "Changes a user makes, each followed by the reads that show it, in order. A playlist's coverArt is volatile: a change to its songs queues its cover for Navidrome's artwork worker (polled every 5 s), which makes a grid of album covers picked at random, at its own moment on each side; --state compares that a cover was made. getStarred2's lists are compared as sets: Go on Windows reads a coarse wall clock, and items starred in one call often get the very same starred_at there, so their order is SQLite's. Each side needs its own copy of the golden database (diff.mjs --go-vs-go and --go-vs-gateway give each its own). Times the server takes from the clock (when something was starred, when a queue or playlist changed) are volatile; plays carry their own time.",
  "volatile": [
    "subsonic-response.serverVersion",
    "subsonic-response.**.starred",
    "subsonic-response.playQueue.changed",
    "subsonic-response.playlist.changed",
    "subsonic-response.playlists.playlist.*.changed",
    "subsonic-response.playlist.coverArt",
    "subsonic-response.playlist.created",
    "subsonic-response.playlists.playlist.*.created",
    "subsonic-response.playlists.playlist.*.coverArt"
  ],
  "unordered": [
    "subsonic-response.**.artist.*.roles",
    "subsonic-response.starred2.song",
    "subsonic-response.starred2.album",
    "subsonic-response.starred2.artist"
  ],
  "requests": [
    { "name": "star a song, an album and an artist", "method": "star", "params": { "id": "{{track.cjk}}", "albumId": "{{album.twoDiscs}}", "artistId": "{{artist.cjk}}" } },
    { "name": "getStarred2 after star", "method": "getStarred2" },
    { "name": "unstar the golden stars", "method": "unstar", "params": { "id": "{{track.flac}}", "albumId": "{{album.compilation}}", "artistId": "{{artist.kenji}}" } },
    { "name": "getStarred2 after unstar", "method": "getStarred2" },
    { "name": "getAlbum after unstar", "method": "getAlbum", "params": { "id": "{{album.compilation}}" } },

    { "name": "setRating a song", "method": "setRating", "params": { "id": "{{track.ogg}}", "rating": 3 } },
    { "name": "setRating an album", "method": "setRating", "params": { "id": "{{album.cjk}}", "rating": 2 } },
    { "name": "setRating 0 clears", "method": "setRating", "params": { "id": "{{track.mp3}}", "rating": 0 } },
    { "name": "getSong after ratings", "method": "getSong", "params": { "id": "{{{{$}}}}" }, "for": ["track.ogg", "track.mp3"] },
    { "name": "getAlbum after rating", "method": "getAlbum", "params": { "id": "{{album.cjk}}" } },

    { "name": "star without any id", "method": "star" },
    { "name": "unstar without any id", "method": "unstar", "post": true },
    { "name": "star an empty id", "method": "star", "params": { "id": "" } },
    { "name": "star an unknown id (skipped) with a known one", "method": "star", "params": { "id": ["not-an-id", "{{track.korean}}"] } },
    { "name": "star the same song twice in one call", "method": "star", "params": { "id": ["{{track.accented}}", "{{track.accented}}"] } },
    { "name": "star it again", "method": "star.view", "params": { "id": "{{track.accented}}" } },
    { "name": "star an album by id, an artist by id", "method": "star", "params": { "id": ["{{album.turkish}}", "{{artist.dax}}"] } },
    { "name": "star a playlist", "method": "star", "params": { "id": "{{playlist.otherUser}}" } },
    { "name": "star another user's private playlist (not seen: skipped)", "method": "star", "auth": { "user": "secure", "as": "appPassword" }, "params": { "id": "{{playlist.own}}" } },
    { "name": "star as a form post, several of each", "method": "star", "post": true, "params": { "id": ["{{track.umlaut}}", "{{track.tilde}}"], "albumId": ["{{album.accented}}", "{{album.normal}}"], "artistId": ["{{artist.lumi}}", "{{artist.turkish}}"] } },
    { "name": "unstar what was never starred", "method": "unstar", "params": { "id": "{{track.dotlessI}}", "albumId": "{{album.sameName.kenji}}" } },
    { "name": "unstar one of the form post's", "method": "unstar.view", "post": true, "params": { "albumId": "{{album.normal}}" } },
    { "name": "star as another user", "method": "star", "auth": { "user": "secure", "as": "appPassword" }, "params": { "id": "{{track.accented}}" } },
    { "name": "getStarred2 after the edge cases", "method": "getStarred2" },
    { "name": "getStarred2 as the other user", "method": "getStarred2", "auth": { "user": "secure", "as": "appPassword" } },
    { "name": "getStarred2 as the admin", "method": "getStarred2", "auth": { "user": "admin", "as": "appPassword" } },
    { "name": "getSong after stars", "method": "getSong", "params": { "id": "{{{{$}}}}" }, "for": ["track.accented", "track.dotlessI", "track.korean"] },

    { "name": "setRating without an id", "method": "setRating", "params": { "rating": 3 } },
    { "name": "setRating without a rating", "method": "setRating", "params": { "id": "{{track.ogg}}" } },
    { "name": "setRating not a number", "method": "setRating", "params": { "id": "{{track.ogg}}", "rating": "three" } },
    { "name": "setRating an unknown id", "method": "setRating", "params": { "id": "not-an-id", "rating": 4 } },
    { "name": "setRating out of range (kept as given)", "method": "setRating", "params": { "id": "{{track.umlaut}}", "rating": 9 } },
    { "name": "setRating negative", "method": "setRating", "params": { "id": "{{track.tilde}}", "rating": -2 } },
    { "name": "setRating an artist", "method": "setRating", "post": true, "params": { "id": "{{artist.aurora}}", "rating": 5 } },
    { "name": "setRating a playlist", "method": "setRating.view", "params": { "id": "{{playlist.otherUser}}", "rating": 4 } },
    { "name": "setRating another user's private playlist", "method": "setRating", "auth": { "user": "secure", "as": "appPassword" }, "params": { "id": "{{playlist.own}}", "rating": 1 } },
    { "name": "setRating the same song as another user (average)", "method": "setRating", "auth": { "user": "secure", "as": "appPassword" }, "params": { "id": "{{track.ogg}}", "rating": 4 } },
    { "name": "setRating the same song as the admin (average)", "method": "setRating", "auth": { "user": "admin", "as": "appPassword" }, "params": { "id": "{{track.ogg}}", "rating": 2 } },
    { "name": "setRating changed by the first user", "method": "setRating", "params": { "id": "{{track.ogg}}", "rating": 5 } },
    { "name": "setRating cleared by the other user", "method": "setRating", "auth": { "user": "secure", "as": "appPassword" }, "params": { "id": "{{track.ogg}}", "rating": 0 } },
    { "name": "getSong after the ratings", "method": "getSong", "params": { "id": "{{{{$}}}}" }, "for": ["track.ogg", "track.umlaut", "track.tilde"] },
    { "name": "getSong after the ratings, as the admin", "method": "getSong", "auth": { "user": "admin", "as": "appPassword" }, "params": { "id": "{{track.ogg}}" } },
    { "name": "getAlbumList2 highest after the ratings", "method": "getAlbumList2", "params": { "type": "highest", "size": 50 } },
    { "name": "getPlaylists after the ratings", "method": "getPlaylists" },

    { "name": "scrobble a play", "method": "scrobble", "params": { "id": "{{track.wav}}", "submission": true, "time": 1767225600000 } },
    { "name": "scrobble two plays at once", "method": "scrobble", "params": { "id": ["{{track.opus}}", "{{track.m4a}}"], "submission": true, "time": [1767312000000, 1767312200000] } },
    { "name": "scrobble now playing", "method": "scrobble", "params": { "id": "{{track.korean}}", "submission": false } },
    { "name": "getSong after plays", "method": "getSong", "params": { "id": "{{{{$}}}}" }, "for": ["track.wav", "track.opus", "track.m4a", "track.korean"] },
    { "name": "getAlbum after plays", "method": "getAlbum", "params": { "id": "{{album.turkish}}" } },
    { "name": "getAlbumList2 frequent after plays", "method": "getAlbumList2", "params": { "type": "frequent", "size": 50 } },
    { "name": "getAlbumList2 recent after plays", "method": "getAlbumList2", "params": { "type": "recent", "size": 50 } },

    { "name": "savePlayQueue", "method": "savePlayQueue", "params": { "id": ["{{track.korean}}", "{{track.japanese}}", "{{track.cjk}}"], "current": "{{track.japanese}}", "position": 2500 } },
    { "name": "getPlayQueue after save", "method": "getPlayQueue" },
    { "name": "savePlayQueue as a form post", "method": "savePlayQueue", "post": true, "params": { "id": ["{{track.flac}}"], "current": "{{track.flac}}", "position": 0 } },
    { "name": "getPlayQueue after the form post", "method": "getPlayQueue" },
    { "name": "savePlayQueue as another user", "method": "savePlayQueue", "auth": { "user": "secure", "as": "appPassword" }, "params": { "id": ["{{track.mp3}}", "{{track.ogg}}"], "current": "{{track.ogg}}", "position": 99000 } },
    { "name": "getPlayQueue of the other user", "method": "getPlayQueue", "auth": { "user": "secure", "as": "appPassword" } },
    { "name": "savePlayQueue: current not in the list, position not a number", "method": "savePlayQueue", "params": { "id": ["{{track.korean}}", "{{track.japanese}}"], "current": "{{track.flac}}", "position": "soon" } },
    { "name": "getPlayQueue after an odd save", "method": "getPlayQueue" },
    { "name": "savePlayQueue with duplicates and an unknown id", "method": "savePlayQueue.view", "post": true, "params": { "id": ["{{track.cjk}}", "not-an-id", "{{track.cjk}}", "{{track.wav}}"], "current": "{{track.wav}}", "position": 12 } },
    { "name": "getPlayQueue after duplicates", "method": "getPlayQueue" },
    { "name": "savePlayQueue without current", "method": "savePlayQueue", "params": { "id": ["{{track.opus}}", "{{track.m4a}}"], "position": 7 } },
    { "name": "getPlayQueue without current", "method": "getPlayQueue" },
    { "name": "savePlayQueue empty (no queue left)", "method": "savePlayQueue", "auth": { "user": "secure", "as": "appPassword" } },
    { "name": "getPlayQueue after the empty save", "method": "getPlayQueue", "auth": { "user": "secure", "as": "appPassword" } },
    { "name": "savePlayQueue again after the empty save (a new queue)", "method": "savePlayQueue", "auth": { "user": "secure", "as": "appPassword" }, "params": { "id": "{{track.flac}}", "current": "{{track.flac}}", "position": 1 } },
    { "name": "getPlayQueue after the new queue", "method": "getPlayQueue", "auth": { "user": "secure", "as": "appPassword" } },

    { "name": "createPlaylist new, with songs (a form post)", "method": "createPlaylist", "post": true, "params": { "name": "Diff New One", "songId": ["{{track.flac}}", "{{track.mp3}}", "{{track.ogg}}"] }, "save": "new1" },
    { "name": "getPlaylist of the new one", "method": "getPlaylist", "params": { "id": "{{saved.new1}}" } },
    { "name": "createPlaylist new, empty", "method": "createPlaylist", "params": { "name": "Diff Empty" }, "save": "empty" },
    { "name": "createPlaylist new, duplicates and an unknown id", "method": "createPlaylist.view", "params": { "name": "Diff Odd Songs", "songId": ["{{track.cjk}}", "{{track.cjk}}", "not-a-song", "{{track.wav}}"] }, "save": "odd" },
    { "name": "createPlaylist without a name or an id", "method": "createPlaylist", "params": { "songId": "{{track.flac}}" } },
    { "name": "createPlaylist with an empty name", "method": "createPlaylist", "params": { "name": "" } },
    { "name": "createPlaylist as another user", "method": "createPlaylist", "auth": { "user": "secure", "as": "appPassword" }, "params": { "name": "Secure's List", "songId": ["{{track.korean}}"] }, "save": "secure" },
    { "name": "createPlaylist overwrite own (playlistId)", "method": "createPlaylist", "post": true, "params": { "playlistId": "{{saved.new1}}", "songId": ["{{track.japanese}}", "{{track.korean}}"] } },
    { "name": "createPlaylist overwrite own without songs (the old ones stay)", "method": "createPlaylist", "params": { "playlistId": "{{saved.odd}}" } },
    { "name": "createPlaylist overwrite with a name too (the name is not changed)", "method": "createPlaylist", "params": { "playlistId": "{{saved.empty}}", "name": "Renamed?", "songId": "{{track.umlaut}}" } },
    { "name": "createPlaylist overwrite another user's", "method": "createPlaylist", "params": { "playlistId": "{{saved.secure}}", "songId": "{{track.flac}}" } },
    { "name": "createPlaylist overwrite another user's public one", "method": "createPlaylist", "params": { "playlistId": "{{playlist.otherUser}}", "songId": "{{track.flac}}" } },
    { "name": "createPlaylist overwrite an unknown id", "method": "createPlaylist", "params": { "playlistId": "not-a-playlist", "songId": "{{track.flac}}" } },
    { "name": "createPlaylist overwrite a smart playlist (Navidrome's)", "method": "createPlaylist", "auth": { "user": "admin", "as": "appPassword" }, "params": { "playlistId": "{{playlist.smart}}", "songId": "{{track.flac}}" }, "navidrome": "a smart playlist: Navidrome writes its rules" },
    { "name": "createPlaylist overwrite as the admin (someone else's)", "method": "createPlaylist", "auth": { "user": "admin", "as": "appPassword" }, "params": { "playlistId": "{{saved.secure}}", "songId": ["{{track.korean}}", "{{track.tilde}}"] } },
    { "name": "getPlaylists after the creates", "method": "getPlaylists" },
    { "name": "getPlaylist after each create", "method": "getPlaylist", "params": { "id": "{{{{$}}}}" }, "for": ["saved.new1", "saved.empty", "saved.odd"] },
    { "name": "getPlaylists as the other user", "method": "getPlaylists", "auth": { "user": "secure", "as": "appPassword" } },

    { "name": "updatePlaylist without playlistId", "method": "updatePlaylist", "params": { "name": "x" } },
    { "name": "updatePlaylist an unknown id", "method": "updatePlaylist", "params": { "playlistId": "not-a-playlist", "name": "x" } },
    { "name": "updatePlaylist nothing to change", "method": "updatePlaylist", "params": { "playlistId": "{{saved.new1}}" } },
    { "name": "updatePlaylist an empty name (kept), an empty comment (set)", "method": "updatePlaylist", "params": { "playlistId": "{{saved.new1}}", "name": "", "comment": "" } },
    { "name": "updatePlaylist public=on", "method": "updatePlaylist", "params": { "playlistId": "{{saved.new1}}", "public": "on" } },
    { "name": "updatePlaylist public=yes (not true)", "method": "updatePlaylist.view", "params": { "playlistId": "{{saved.odd}}", "public": "yes" } },
    { "name": "updatePlaylist remove out of range, negative, not a number, twice the same", "method": "updatePlaylist", "post": true, "params": { "playlistId": "{{saved.odd}}", "songIndexToRemove": ["100", "-1", "x", "1", "1"] } },
    { "name": "getPlaylist after odd removes", "method": "getPlaylist", "params": { "id": "{{saved.odd}}" } },
    { "name": "updatePlaylist remove and add together, with a name", "method": "updatePlaylist", "post": true, "params": { "playlistId": "{{saved.new1}}", "songIndexToRemove": "0", "songIdToAdd": ["{{track.accented}}", "{{track.accented}}"], "name": "Diff New One (2)" } },
    { "name": "updatePlaylist add an empty id", "method": "updatePlaylist", "params": { "playlistId": "{{saved.empty}}", "songIdToAdd": "" } },
    { "name": "updatePlaylist remove every song", "method": "updatePlaylist", "params": { "playlistId": "{{saved.empty}}", "songIndexToRemove": ["0", "1", "2"] } },
    { "name": "getPlaylist after removing every song", "method": "getPlaylist", "params": { "id": "{{saved.empty}}" } },
    { "name": "updatePlaylist add to the empty playlist", "method": "updatePlaylist", "params": { "playlistId": "{{saved.empty}}", "songIdToAdd": ["{{track.wav}}", "{{track.m4a}}"] } },
    { "name": "updatePlaylist another user's, songs only", "method": "updatePlaylist", "params": { "playlistId": "{{saved.secure}}", "songIdToAdd": "{{track.flac}}" } },
    { "name": "updatePlaylist as the admin (someone else's)", "method": "updatePlaylist", "auth": { "user": "admin", "as": "appPassword" }, "params": { "playlistId": "{{saved.secure}}", "comment": "seen by the admin" } },
    { "name": "updatePlaylist a smart playlist's name (Navidrome's)", "method": "updatePlaylist", "auth": { "user": "admin", "as": "appPassword" }, "params": { "playlistId": "{{playlist.smart}}", "name": "Smart, renamed" }, "navidrome": "a smart playlist: Navidrome writes its rules" },
    { "name": "getPlaylist after the updates", "method": "getPlaylist", "params": { "id": "{{{{$}}}}" }, "for": ["saved.new1", "saved.empty", "saved.odd"] },
    { "name": "getPlaylist of the other user's after the admin's changes", "method": "getPlaylist", "auth": { "user": "secure", "as": "appPassword" }, "params": { "id": "{{saved.secure}}" } },
    { "name": "getPlaylists after the updates", "method": "getPlaylists" },

    { "name": "deletePlaylist without an id", "method": "deletePlaylist" },
    { "name": "deletePlaylist an unknown id", "method": "deletePlaylist", "params": { "id": "not-a-playlist" } },
    { "name": "deletePlaylist another user's (not seen: private)", "method": "deletePlaylist", "params": { "id": "{{saved.secure}}" } },
    { "name": "deletePlaylist as a form post", "method": "deletePlaylist", "post": true, "params": { "id": "{{saved.odd}}" } },
