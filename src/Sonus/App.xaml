<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Sonus.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                Visual language: the CreeperUX design tokens (fb2k's vendor/creeperux-gui/tokens.json, dark mode) with
                foobar2k's own (f2k-*): three rounded panels on a near-black window, the playback bar along the bottom,
                one amber accent (#f8b700) for what is playing, progress and the main Play buttons.
                WinUI fills accent controls (AccentButton, radio, toggle, slider) with SystemAccentColorLight2 in the dark
                theme and writes accent text with Light3: both are the brand amber here, not lighter tints of it.
            -->
            <Color x:Key="SystemAccentColor">#FFF8B700</Color>
            <Color x:Key="SystemAccentColorLight1">#FFFFC522</Color>
            <Color x:Key="SystemAccentColorLight2">#FFF8B700</Color>
            <Color x:Key="SystemAccentColorLight3">#FFF8B700</Color>
            <Color x:Key="SystemAccentColorDark1">#FFE5A800</Color>
            <Color x:Key="SystemAccentColorDark2">#FFC48F00</Color>
            <Color x:Key="SystemAccentColorDark3">#FF8A6200</Color>

            <Color x:Key="PanelColor">#FF151B1F</Color>
            <Color x:Key="RaisedColor">#FF20272C</Color>
            <Color x:Key="RaisedHiColor">#FF2A3338</Color>
            <Color x:Key="TextColor">#FFF4F1EB</Color>
            <Color x:Key="QuietColor">#FF839196</Color>                                    <!-- cx-panel -->
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#FF040607" />                <!-- f2k-bg -->
            <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}" />
            <SolidColorBrush x:Key="RaisedBrush" Color="#FF20272C" />                       <!-- f2k-raise: chips, cards, round buttons -->
            <SolidColorBrush x:Key="RaisedHiBrush" Color="#FF2A3338" />                     <!-- f2k-raise-hi: their hover -->
            <SolidColorBrush x:Key="HoverBrush" Color="#12EFEBE5" />                        <!-- f2k-hover: rgba(239,235,229,.07) -->
            <SolidColorBrush x:Key="SurfaceBrush" Color="#17F4F1EB" />                      <!-- quick tiles: text at 9 % -->
            <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#2BF4F1EB" />                 <!-- … at 17 % under the pointer -->
            <SolidColorBrush x:Key="LineBrush" Color="#24EFEBE5" />                         <!-- cx-line -->
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFF4F1EB" />                  <!-- cx-text -->
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FFA9B0B3" />                <!-- cx-muted -->
            <SolidColorBrush x:Key="TextTertiaryBrush" Color="#FF839196" />                 <!-- cx-quiet -->
            <SolidColorBrush x:Key="AccentBrush" Color="#FFF8B700" />                       <!-- cx-accent -->
            <SolidColorBrush x:Key="AccentHiBrush" Color="#FFFFC522" />                     <!-- cx-accent-hi: hover -->
            <SolidColorBrush x:Key="AccentTextBrush" Color="#FFF8B700" />                   <!-- cx-accent-text -->
            <Color x:Key="OnAccentColor">#FF111416</Color>
            <SolidColorBrush x:Key="OnAccentBrush" Color="{StaticResource OnAccentColor}" />  <!-- cx-on-accent -->
            <SolidColorBrush x:Key="BadBrush" Color="#FFC1877C" />                          <!-- cx-bad -->
            <SolidColorBrush x:Key="OfflineBrush" Color="#38C1877C" />                      <!-- cx-bad at 22 %: offline connection pill -->
            <SolidColorBrush x:Key="OfflineHoverBrush" Color="#4DC1877C" />                 <!-- … at 30 % under the pointer -->
            <SolidColorBrush x:Key="GoodBrush" Color="#FF80AB9E" />                         <!-- cx-good -->
            <SolidColorBrush x:Key="WarnBrush" Color="#FFD9A441" />                         <!-- cx-warn -->
            <SolidColorBrush x:Key="InfoBrush" Color="#FF6497A7" />                         <!-- cx-info -->
            <SolidColorBrush x:Key="ToastBrush" Color="#FF1B2227" />                        <!-- cx-raised: toasts -->

            <!-- Accent buttons (Play, sign in): the amber, brighter under the pointer (cx-accent-hi), as foobar2k's -->
            <SolidColorBrush x:Key="AccentButtonBackground" Color="#FFF8B700" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#FFFFC522" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#FFF8B700" />
            <SolidColorBrush x:Key="AccentButtonForeground" Color="#FF111416" />
            <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#FF111416" />
            <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#FF111416" />

            <!-- Menus and dialogs: solid, in the app's cool dark palette rather than WinUI's warm-grey default -->
            <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#FF20272C" />
            <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="#24EFEBE5" />
            <SolidColorBrush x:Key="ContentDialogBackground" Color="#FF1B2227" />
            <SolidColorBrush x:Key="ContentDialogTopOverlay" Color="#FF151B1F" />
            <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="#24EFEBE5" />
            <SolidColorBrush x:Key="ContentDialogSeparatorBorderBrush" Color="#24EFEBE5" />
            <SolidColorBrush x:Key="ContentDialogSmokeFill" Color="#8C030506" />

            <!-- Lists: selection is shown by the playing song, not by the system highlight -->
            <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#1FEFEBE5" />
            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#29EFEBE5" />
            <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#12EFEBE5" />
            <SolidColorBrush x:Key="ListViewItemSelectionIndicatorBrush" Color="#00000000" />
            <SolidColorBrush x:Key="ListViewItemSelectionIndicatorPointerOverBrush" Color="#00000000" />

            <!--
                Typography: Chinese falls back to Microsoft YaHei UI, which has no SemiBold; headings use Bold so Latin and
                Chinese match (as in Lumen).
            -->
            <FontFamily x:Key="ContentControlThemeFontFamily">Segoe UI Variable Text, Microsoft YaHei UI</FontFamily>
            <FontFamily x:Key="AppTextFont">Segoe UI Variable Text, Microsoft YaHei UI</FontFamily>
            <!-- headings and the brand: foobar2k's display face, Chakra Petch (SemiBold, Latin; Assets/Fonts, SIL OFL 1.1) -->
            <FontFamily x:Key="AppDisplayFont">ms-appx:///Assets/Fonts/ChakraPetch-SemiBold.ttf#Chakra Petch, Microsoft YaHei UI</FontFamily>
            <FontFamily x:Key="AppFigureFont">Cascadia Mono, Consolas, Microsoft YaHei UI</FontFamily>

            <Style x:Key="HeroTitleStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource AppDisplayFont}" />
                <Setter Property="FontSize" Value="48" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="LineHeight" Value="56" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="MaxLines" Value="2" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            </Style>
            <Style x:Key="PageTitleStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource AppDisplayFont}" />
                <Setter Property="FontSize" Value="30" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            </Style>
            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource AppDisplayFont}" />
                <Setter Property="FontSize" Value="22" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            </Style>
            <Style x:Key="CardTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="TextWrapping" Value="NoWrap" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            </Style>
            <Style x:Key="MutedTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            </Style>
            <Style x:Key="FigureTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource AppFigureFont}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            </Style>

            <!-- A round, borderless icon button (transport, panel toggles, "more") -->
            <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="36" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="18" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                <Setter Property="FontFamily" Value="{StaticResource SymbolThemeFontFamily}" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <Style x:Key="IconToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="36" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="18" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                <Setter Property="FontFamily" Value="{StaticResource SymbolThemeFontFamily}" />
                <Setter Property="FontSize" Value="16" />
            </Style>
            <!-- The amber Play button (page actions); the playback bar's is white -->
            <Style x:Key="PlayButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                <Setter Property="Width" Value="56" />
                <Setter Property="Height" Value="56" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="28" />
                <Setter Property="FontFamily" Value="{StaticResource SymbolThemeFontFamily}" />
                <Setter Property="FontSize" Value="22" />
                <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
            </Style>
            <Style x:Key="PillButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="Padding" Value="14,6" />
                <Setter Property="Background" Value="{StaticResource RaisedBrush}" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>
            <Style x:Key="ChipStyle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="Padding" Value="14,5" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="Background" Value="{StaticResource RaisedBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FontSize" Value="13" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
