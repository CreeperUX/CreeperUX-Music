{
  "name": "sonus",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Sonus: a Spotify-style Windows player (WinUI 3) for your own Navidrome (Subsonic) server",
  "scripts": {
    "demo": "node tools/demo.mjs",
    "demo:browser": "node tools/demo.mjs --browser",
    "server": "node server/demo-server.mjs",
    "build": "dotnet build src/Sonus/Sonus.csproj -c Release",
    "test": "dotnet test tests/Sonus.Core.Tests",
    "check": "node tools/e2e/acceptance.mjs",
    "check:web": "node tools/check-web.mjs",
    "package": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/package.ps1",
    "icon": "node tools/icon.mjs",
    "covers": "node tools/render-covers.mjs",
    "sync-kit": "node tools/sync-kit.mjs",
    "check:kit": "node tools/sync-kit.mjs --check"
  },
  "devDependencies": {
    "axe-core": "4.14.0",
    "playwright": "1.64.1"
  }
}
