{
  "$description": "CreeperUX design tokens: the single source for kit/foundation.css, kit/tokens.js and kit/tokens.json (DTCG export). Edit this file, then run `npm run build:kit`. Decisions: D10–D18, D27 (quiet motion), D30 (neutral defaults).",
  "color": {
    "bg": {
      "$type": "color",
      "$value": "#0d1114",
      "$extensions": {
        "com.creeperux.modes": {
          "light": "#efebe5",
          "forcedColors": "Canvas"
        }
      }
    },
    "deep": {
      "$type": "color",
      "$value": "#090d10",
      "$extensions": {
        "com.creeperux.modes": {
          "light": "#e6e1d8",
          "forcedColors": "Canvas"
        }
      }
    },
    "panel": {
      "$type": "color",
      "$value": "#151b1f",
      "$extensions": {
        "com.creeperux.modes": {
          "light": "#f8f6f1",
          "forcedColors": "Canvas"
        }
      }
    },
    "raised": {
      "$type": "color",
      "$value": "#1b2227",
      "$extensions": {
        "com.creeperux.modes": {
          "light": "#ffffff",
          "forcedColors": "Canvas"
        }
      }
    },
    "hover": {
      "$type": "color",
      "$value": "#20272b",
      "$extensions": {
        "com.creeperux.modes": {
          "light": "#ffffff",
          "forcedColors": "Canvas"
        }
      }
    },
    "text": {
      "$type": "color",
      "$value": "#f4f1eb",
      "$extensions": {
        "com.creeperux.modes": {
          "light": "#111416",
          "forcedColors": "CanvasText"
        }
      }
    },
    "muted": {
      "$type": "color",
      "$value": "#a9b0b3",
      "$extensions": {
        "com.creeperux.modes": {
          "light": "#5c6265",
          "forcedColors": "CanvasText"
        }
      }
    },
    "quiet": {
      "$type": "color",
      "$value": "#839196",
      "$extensions": {
        "com.creeperux.modes": {
          "light": "#5f6466",
          "forcedColors": "GrayText"
        }
      }
    },
    "line": {
      "$type": "color",
      "$value": "rgba(239, 235, 229, .14)",
      "$extensions": {
        "com.creeperux.modes": {
          "light": "rgba(5, 6, 7, .15)",
          "forcedColors": "CanvasText"
        }
      }
    },
    "faint": {
      "$type": "color",
      "$value": "rgba(239, 235, 229, .07)",
      "$extensions": {
        "com.creeperux.modes": {
          "light": "rgba(5, 6, 7, .07)",
          "forcedColors": "GrayText"
        }
      }
    },
    "control": {
      "$type": "color",
      "$value": "#373737",
      "$extensions": {
        "com.creeperux.modes": {
          "light": "#d9d1c4",
          "forcedColors": "ButtonFace"
        }
      }
    },
    "boundary": {
      "$type": "color",
      "$value": "#6b767c",
      "$extensions": {
        "com.creeperux.modes": {
          "light": "#827d75",
          "forcedColors": "CanvasText"
        }
      },
      "$description": "Control edges: 3:1 or more on every surface (WCAG 1.4.11, D65). --cx-line stays for decorative separators."
    },
    "accent": {
      "$type": "color",
      "$value": "#f8b700",
      "$extensions": {
        "com.creeperux.modes": {
          "light": "#f8b700",
          "forcedColors": "Highlight"
        }
      },
      "$description": "Brand accent; override for another brand. Fills and large marks."
    },
    "accent-hi": {
      "$type": "color",
      "$value": "#ffc522",
      "$extensions": {
        "com.creeperux.modes": {
          "light": "#ffc522",
          "forcedColors": "Highlight"
        }
      }
    },
    "accent-text": {
      "$type": "color",
      "$value": "#f8b700",
      "$extensions": {
        "com.creeperux.modes": {
          "light": "#6c4c00",
          "forcedColors": "LinkText"
        }
      },
      "$description": "Accent used as text: dark gold in light mode (D16)."
    },
    "accent-mark": {
      "$type": "color",
      "$value": "#f8b700",
      "$extensions": {
        "com.creeperux.modes": {
          "light": "#8a6200",
          "forcedColors": "Highlight"
        }
      },
      "$description": "Small marks and indicators (selection edge, active tab)."
    },
    "on-accent": {
      "$type": "color",
      "$value": "#111416",
      "$extensions": {
        "com.creeperux.modes": {
          "light": "#111416",
          "forcedColors": "HighlightText"
        }
      }
    },
    "accent-soft": {
      "$type": "color",
      "$value": "rgba(248, 183, 0, .12)",
      "$extensions": {
        "com.creeperux.modes": {
          "light": "rgba(248, 183, 0, .22)",
          "forcedColors": "Canvas"
        }
      }
    },
    "focus": {
      "$type": "color",
      "$value": "#f8b700",
      "$extensions": {
        "com.creeperux.modes": {
          "light": "#8a6200",
          "forcedColors": "Highlight"
        }
      }
    },
    "info": {
      "$type": "color",
      "$value": "#6497a7",
      "$extensions": {
        "com.creeperux.modes": {
          "light": "#406878",
          "forcedColors": "CanvasText"
        }
      }
    },
    "good": {
      "$type": "color",
      "$value": "#80ab9e",
      "$extensions": {
        "com.creeperux.modes": {
          "light": "#326d5d",
          "forcedColors": "CanvasText"
        }
      }
    },
    "bad": {
      "$type": "color",
      "$value": "#c1877c",
      "$extensions": {
        "com.creeperux.modes": {
          "light": "#944e46",
          "forcedColors": "CanvasText"
        }
      }
    },
    "warn": {
      "$type": "color",
      "$value": "#d9a441",
      "$extensions": {
        "com.creeperux.modes": {
          "light": "#805b00",
          "forcedColors": "CanvasText"
        }
      }
    },
    "scrim": {
      "$type": "color",
      "$value": "rgba(3, 5, 6, .55)",
      "$extensions": {
        "com.creeperux.modes": {
          "light": "rgba(40, 36, 30, .28)",
          "forcedColors": "transparent"
        }
      }
    },
    "shadow": {
      "$type": "shadow",
      "$value": "0 16px 48px rgba(0, 0, 0, .45)",
      "$extensions": {
        "com.creeperux.modes": {
          "light": "0 14px 40px rgba(40, 32, 20, .18)",
          "forcedColors": "none"
        }
      }
    }
  },
  "dimension": {
    "compact-fs": {
      "$type": "dimension",
      "$value": "13px"
    },
    "compact-fs-sm": {
      "$type": "dimension",
      "$value": "12px"
    },
    "compact-fs-xs": {
      "$type": "dimension",
      "$value": "11px"
    },
    "compact-ctl": {
      "$type": "dimension",
      "$value": "28px"
    },
    "compact-row": {
      "$type": "dimension",
      "$value": "34px"
    },
    "compact-hit": {
      "$type": "dimension",
      "$value": "28px"
    },
    "compact-gap": {
      "$type": "dimension",
      "$value": "8px"
    },
    "compact-pad": {
      "$type": "dimension",
      "$value": "12px"
    },
    "compact-gutter": {
      "$type": "dimension",
      "$value": "16px"
    },
    "compact-icon": {
      "$type": "dimension",
      "$value": "16px"
    },
    "touch-fs": {
      "$type": "dimension",
      "$value": "14px"
    },
    "touch-fs-sm": {
      "$type": "dimension",
      "$value": "12.5px"
    },
    "touch-fs-xs": {
      "$type": "dimension",
      "$value": "11.5px"
    },
    "touch-ctl": {
      "$type": "dimension",
      "$value": "36px"
    },
    "touch-row": {
      "$type": "dimension",
      "$value": "44px"
    },
    "touch-hit": {
      "$type": "dimension",
      "$value": "44px"
    },
    "touch-gap": {
      "$type": "dimension",
      "$value": "8px"
    },
    "touch-pad": {
      "$type": "dimension",
      "$value": "12px"
    },
    "touch-gutter": {
      "$type": "dimension",
      "$value": "16px"
    },
    "touch-icon": {
      "$type": "dimension",
      "$value": "18px"
    },
    "radius-panel": {
      "$type": "dimension",
      "$value": "6px"
    },
    "radius-control": {
      "$type": "dimension",
      "$value": "5px"
    },
    "radius-chip": {
      "$type": "dimension",
      "$value": "4px"
    }
  },
  "motion": {
    "press": {
      "$type": "transition",
      "$value": {
        "duration": "60ms",
        "delay": "0ms",
        "timingFunction": [
          0.2,
          0.8,
          0.2,
          1
        ]
      },
      "$description": "pointer down (scale 0.985)"
    },
    "release": {
      "$type": "transition",
      "$value": {
        "duration": "120ms",
        "delay": "0ms",
        "timingFunction": [
          0.2,
          0.8,
          0.2,
          1
        ]
      },
      "$description": "pointer up"
    },
    "control": {
      "$type": "duration",
      "$value": "200ms",
      "$description": "small indicators: segmented, nav, selection, active option",
      "$extensions": {
        "com.creeperux.spring": {
          "response": 0.2,
          "dampingRatio": 1
        }
      }
    },
    "detent": {
      "$type": "duration",
      "$value": "240ms",
      "$description": "switch knob, slider snap (only tactile role)",
      "$extensions": {
        "com.creeperux.spring": {
          "response": 0.24,
          "dampingRatio": 0.82
        }
      }
    },
    "drag": {
      "$type": "duration",
      "$value": "320ms",
      "$description": "release of a dragged sheet or handle",
      "$extensions": {
        "com.creeperux.spring": {
          "response": 0.32,
          "dampingRatio": 0.9
        }
      }
    },
    "enter": {
      "$type": "transition",
      "$value": {
        "duration": "140ms",
        "delay": "0ms",
        "timingFunction": [
          0.2,
          0.8,
          0.2,
          1
        ]
      },
      "$description": "overlay / item entrance: opacity + at most 4 px"
    },
    "exit": {
      "$type": "transition",
      "$value": {
        "duration": "90ms",
        "delay": "0ms",
        "timingFunction": [
          0.4,
          0,
          0.9,
          0.55
        ]
      },
      "$description": "overlay / item exit"
    },
    "layout": {
      "$type": "transition",
      "$value": {
        "duration": "180ms",
        "delay": "0ms",
        "timingFunction": [
          0.2,
          0.8,
          0.2,
          1
        ]
      },
      "$description": "height of inserted / removed items"
    },
    "list": {
      "$type": "duration",
      "$value": "0ms",
      "$description": "reorder and filter move instantly; new items fade with enter",
      "$extensions": {
        "com.creeperux.spring": null
      }
    },
    "view": {
      "$type": "transition",
      "$value": {
        "duration": "150ms",
        "delay": "0ms",
        "timingFunction": [
          0.2,
          0.8,
          0.2,
          1
        ]
      },
      "$description": "view and content swap: opacity only"
    },
    "viewExit": {
      "$type": "duration",
      "$value": "0ms",
      "$description": "outgoing view leaves at once",
      "$extensions": {
        "com.creeperux.spring": null
      }
    },
    "push": {
      "$type": "transition",
      "$value": {
        "duration": "220ms",
        "delay": "0ms",
        "timingFunction": [
          0.2,
          0.8,
          0.2,
          1
        ]
      },
      "$description": "phone push navigation (spatial)"
    },
    "sheet": {
      "$type": "duration",
      "$value": "320ms",
      "$description": "drawer / sheet open and programmatic close",
      "$extensions": {
        "com.creeperux.spring": {
          "response": 0.32,
          "dampingRatio": 1
        }
      }
    },
    "expand": {
      "$type": "transition",
      "$value": {
        "duration": "180ms",
        "delay": "0ms",
        "timingFunction": [
          0.2,
          0.8,
          0.2,
          1
        ]
      },
      "$description": "disclosure height"
    }
  }
}
